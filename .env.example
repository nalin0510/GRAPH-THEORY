# Optional: Google Maps Platform browser API key for Live Map mode.
# Demo City, Network Lab, Play, and Compare modes run 100% offline without any API key.
# Restrict this browser key in Google Cloud Console by HTTP referrers and limit to:
#   - Maps JavaScript API
#   - Places API (New)
#   - Routes API
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: Automatically injected by the hosting environment at runtime.
APP_URL="MY_APP_URL"
